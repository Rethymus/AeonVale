{
  "name": "aeon-vale-song-of-the-dao",
  "version": "0.1.0",
  "description": "永恒山谷：大道之歌 — 纯代码修仙种田 + 炼丹 + 天劫塔防生存游戏（全程中文，MIT 开源）",
  "type": "module",
  "license": "MIT",
  "author": "Aeon Vale Dev",
  "private": false,
  "repository": {
    "type": "git",
    "url": "TODO"
  },
  "keywords": ["game", "xianxia", "farming-sim", "alchemy", "tower-defense", "typescript", "pixijs"],
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:fast": "vitest run tests/unit tests/property",
    "test:replay": "vitest run tests/replay",
    "replay:update": "tsx tools/update-golden-replay.ts",
    "coverage": "vitest run --coverage",
    "headless": "tsx tools/headless-run.ts",
    "m5:check": "tsx tools/m5-certify.ts --profile pr --fail-on structural",
    "m5:report": "tsx tools/m5-certify.ts --profile local --fail-on never",
    "m5:certify": "tsx tools/m5-certify.ts --profile nightly --fail-on targets",
    "balance": "tsx tools/balance-scan.ts",
    "tune": "tsx tools/balance-tune.ts",
    "content:lint": "tsx tools/content-lint.ts"
  },
  "dependencies": {
    "pixi.js": "^8.6.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "@vitest/coverage-v8": "^2.1.0",
    "fast-check": "^3.19.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
