{
  "name": "aeon-vale-song-of-the-dao",
  "version": "0.1.0",
  "description": "永恒山谷：大道之歌 — 纯代码修仙 roguelite《偷天换劫》+ 第一人称叙事《灵韵叙录》（全程中文，MIT 开源）",
  "type": "module",
  "license": "MIT",
  "author": "AeonVale",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/Rethymus/AeonVale.git"
  },
  "keywords": [
    "game",
    "xianxia",
    "roguelite",
    "cultivation",
    "sokoban",
    "visual-novel",
    "narrative",
    "alchemy",
    "typescript",
    "pixijs"
  ],
  "scripts": {
    "dev": "node node_modules/vite/bin/vite.js",
    "build": "node node_modules/typescript/bin/tsc --noEmit && node node_modules/vite/bin/vite.js build",
    "preview": "node node_modules/vite/bin/vite.js preview",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "test": "node node_modules/vitest/vitest.mjs run",
    "test:watch": "node node_modules/vitest/vitest.mjs",
    "test:fast": "node node_modules/vitest/vitest.mjs run tests/unit tests/property",
    "perf:audit": "node node_modules/tsx/dist/cli.mjs tools/perf-audit.ts",
    "test:replay": "node node_modules/vitest/vitest.mjs run tests/replay",
    "replay:cultivation:update": "node node_modules/tsx/dist/cli.mjs tools/update-cultivation-replay.ts",
    "coverage": "node node_modules/vitest/vitest.mjs run --coverage",
    "render:bgm": "node node_modules/tsx/dist/cli.mjs tools/render-bgm.ts",
    "cultivation:metrics": "node node_modules/tsx/dist/cli.mjs tools/cultivation-metrics.ts",
    "cultivation:check": "node node_modules/tsx/dist/cli.mjs tools/cultivation-metrics.ts --seeds 8 --generations 4 --check",
    "content:lint": "node node_modules/tsx/dist/cli.mjs tools/content-lint.ts",
    "governance:check": "node tools/governance-check.mjs",
    "governance:public": "node tools/publication-check.mjs",
    "governance:dist": "node tools/public-dist-check.mjs",
    "governance:readiness": "node tools/public-readiness-check.mjs",
    "portfolio:status": "node tools/portfolio-status.mjs",
    "portfolio:release-checklist": "node tools/portfolio-release-checklist.mjs",
    "portfolio:pages-diagnose": "node tools/portfolio-pages-diagnose.mjs",
    "portfolio:pages-watch": "node tools/portfolio-pages-watch.mjs",
    "portfolio:mvp-preflight": "node tools/portfolio-mvp-preflight.mjs",
    "commitlint": "node node_modules/@commitlint/cli/cli.js",
    "test:browser": "node node_modules/@playwright/test/cli.js test",
    "test:browser:smoke": "node node_modules/@playwright/test/cli.js test tests/browser/smoke.spec.ts",
    "test:browser:keypoint": "node node_modules/@playwright/test/cli.js test tests/browser/cultivation-keypoint.spec.ts",
    "test:browser:first-loop": "node node_modules/@playwright/test/cli.js test tests/browser/first-loop.regression.spec.ts",
    "test:browser:r1-input": "node node_modules/@playwright/test/cli.js test tests/browser/cultivation-schedule-accessibility.spec.ts",
    "test:browser:pages": "node tools/run-pages-smoke.mjs",
    "test:browser:pages-playable": "node tools/run-pages-smoke.mjs tests/browser/pages-playable.spec.ts",
    "portfolio:capture": "node node_modules/@playwright/test/cli.js test tests/browser/portfolio-capture.spec.ts --reporter=line",
    "readme:capture": "README_CAPTURE=1 node node_modules/@playwright/test/cli.js test tests/browser/readme-capture.spec.ts --reporter=line",
    "readme:gif": "node tools/readme-gif.mjs",
    "readme:media": "pnpm readme:capture && pnpm readme:gif",
    "prepare": "node node_modules/simple-git-hooks/cli.js"
  },
  "simple-git-hooks": {
    "commit-msg": "pnpm commitlint --edit $1"
  },
  "dependencies": {
    "pixi.js": "^8.6.0",
    "tone": "^15.1.22",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@playwright/test": "^1.61.1",
    "@types/node": "^22.7.0",
    "@vitest/coverage-v8": "^2.1.0",
    "fast-check": "^3.19.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.5",
    "simple-git-hooks": "^2.13.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
