+function ambientBobOffset(timeMs: number, key: number, amplitude: number, cycleMs: number): number {
+  const phase = key * 0.61803398875;
+  return Math.sin((timeMs / cycleMs) * Math.PI * 2 + phase) * amplitude;
+}
